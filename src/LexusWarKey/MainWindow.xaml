<Window x:Class="LexusWarKey.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LexusWarKey.ViewModels"
        Title="Lexus WarKey" Width="820" Height="700" MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource B.Bg}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Background="{StaticResource B.Panel}" Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/app.ico" Width="40" Height="40" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,14,0" />
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource H1}">
                                <Run Text="Lexus" Foreground="{StaticResource B.Blue}" /><Run Text=" WarKey" />
                            </TextBlock>
                            <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource B.Dim}" FontSize="12"
                                       VerticalAlignment="Bottom" Margin="8,0,0,4" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Style="{StaticResource Dim}" Text="Эд зүйл • Чадвар • Quick Chat" />
                            <TextBlock Text="  ·  " Foreground="{StaticResource B.Border}" FontSize="12" />
                            <TextBlock Text="Бүтээгч " Foreground="{StaticResource B.Dim}" FontSize="12" />
                            <TextBlock Text="Lil" Foreground="{StaticResource B.Red}" FontSize="12" FontWeight="Bold" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- manual update check: always one click away, not buried in a tab -->
                <Button Grid.Column="1" VerticalAlignment="Center"
                        Margin="0,0,14,0" Command="{Binding CheckUpdateNowCommand}"
                        ToolTip="GitHub-аас шинэ хувилбар байгаа эсэхийг шалгана">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCheckingUpdate}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="⟳ Шинэчлэлт шалгах" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCheckingUpdate}" Value="True">
                                        <Setter Property="Text" Value="Шалгаж байна…" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <!-- status pill -->
                <Border Grid.Column="2" CornerRadius="20" Padding="14,8" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#2A2724" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsLive}" Value="True">
                                    <Setter Property="Background" Value="#23332A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource B.Dim}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsLive}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource B.Ok}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource B.Dim}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Body ===== -->
        <Grid Grid.Row="1" Margin="22,16,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- toggles -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12">
                <StackPanel Orientation="Horizontal">
                    <CheckBox IsChecked="{Binding IsEnabled}" Content="Идэвхтэй" FontWeight="SemiBold" />
                    <TextBlock Text="Ctrl + F5" Foreground="{StaticResource B.Dim}" FontSize="11" VerticalAlignment="Center" Margin="8,1,0,0" />
                    <Rectangle Width="1" Fill="{StaticResource B.Border}" Margin="20,2" />
                    <CheckBox IsChecked="{Binding OnlyWhenGameFocused}" Content="Зөвхөн Warcraft дотор" />
                    <Rectangle Width="1" Fill="{StaticResource B.Border}" Margin="20,2" />
                    <CheckBox IsChecked="{Binding StartWithWindows}" Content="Windows-тэй хамт асаах" />
                    <Rectangle Width="1" Fill="{StaticResource B.Border}" Margin="20,2" />
                    <CheckBox IsChecked="{Binding MinimiseToTray}" Content="Хаахад tray-д үлдэх" />
                    <Rectangle Width="1" Fill="{StaticResource B.Border}" Margin="20,2" />
                    <TextBlock Text="Тоглоом дотор: Ctrl + F6" Foreground="{StaticResource B.Dim}"
                               FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1">
                <!-- update banner -->
                <Border CornerRadius="8" Background="#243328" Padding="14,11" Margin="0,10,0,0"
                        Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UpdateText}" Foreground="{StaticResource B.Ok}" FontWeight="SemiBold" FontSize="13" />
                            <ProgressBar Height="4" Margin="0,8,0,0" Minimum="0" Maximum="1"
                                         Value="{Binding UpdateProgress, Mode=OneWay}" Foreground="{StaticResource B.Ok}"
                                         Background="#1A1817" BorderThickness="0"
                                         Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Btn.Ghost}" Content="Юу шинэчлэгдсэн?" Command="{Binding OpenReleasePageCommand}" />
                            <Button Style="{StaticResource Btn.Accent}" Content="Шинэчлэх" Margin="8,0,0,0"
                                    Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding IsUpdating, Converter={StaticResource InverseBool}}" />
                            <Button Style="{StaticResource Btn.Ghost}" Content="✕" Margin="4,0,0,0" Command="{Binding DismissUpdateCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- why nothing is happening -->
                <Border CornerRadius="8" Background="{StaticResource B.RedDim}" BorderBrush="{StaticResource B.Red}"
                        BorderThickness="1" Padding="14,11" Margin="0,10,0,0"
                        Visibility="{Binding HasProblems, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Товч ажиллахгүй байгаа шалтгаан" Foreground="{StaticResource B.Red}"
                                   FontWeight="Bold" FontSize="13" />
                        <TextBlock Text="{Binding ProblemText}" Foreground="{StaticResource B.Text}" FontSize="12"
                                   Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- conflict warning -->
                <Border CornerRadius="8" Background="#2A2416" Padding="12,9" Margin="0,10,0,0"
                        Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ConflictText}" Foreground="{StaticResource B.Warn}" FontSize="12" />
                </Border>
            </StackPanel>

            <TabControl Grid.Row="2" Margin="0,14,0,0">

                <!-- ===== Keys: inventory and skills side by side, like the game ===== -->
                <TabItem Header="Товч">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">

                                <!-- Inventory 2x3 -->
                                <Border Style="{StaticResource Card}" Padding="16,14" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PanelTitle}" Text="Inventory" />
                                        <ItemsControl ItemsSource="{Binding InventoryRows}" Width="180">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource SlotButton}" Content="{Binding FromDisplay}"
                                                            Tag="{Binding Label}"
                                                            Command="{Binding CaptureFromCommand}"
                                                            ToolTip="Дараад шинэ товчоо дар · Backspace = цэвэрлэх" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Skills: the full 4x3 command card, same shape as the game -->
                                <Border Style="{StaticResource Card}" Padding="16,14" Margin="14,0,0,0" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PanelTitle}" Text="Skills" />
                                        <ItemsControl ItemsSource="{Binding SkillRows}" Width="360">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource SlotButton}" Content="{Binding FromDisplay}"
                                                            Tag="{Binding Label}"
                                                            Command="{Binding CaptureFromCommand}"
                                                            ToolTip="Дараад шинэ товчоо дар · Backspace = цэвэрлэх" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0" HorizontalAlignment="Center"
                                                   Text="Auto-Cast: Alt + товч   ·   Чадвар сурах: Ctrl + товч" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- position mode + calibration -->
                            <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,14,0,0">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding SkillsUsePosition}" FontWeight="SemiBold"
                                              Content="Чадварыг БАЙРЛАЛААР дарах (LoD / random чадвар)" />
                                    <TextBlock Style="{StaticResource Dim}" Margin="27,6,0,0"
                                               Text="Асаалттай үед таны товч дарахад тэр байрлалд байгаа чадвар дарагдана — үсэг нь юу ч байсан хамаагүй. Товшилтыг тоглоомын цонх руу шууд илгээдэг тул курсор чинь огт хөдлөхгүй." />
                                    <TextBlock Style="{StaticResource Dim}" Margin="27,6,0,0" Foreground="{StaticResource B.Warn}"
                                               Text="{Binding CalibrationText}" />
                                    <StackPanel Orientation="Horizontal" Margin="27,10,0,0">
                                        <Button Style="{StaticResource Btn.Accent}" Content="Командын карт тохируулах"
                                                Command="{Binding CalibrateCommand}" />
                                        <Button Style="{StaticResource Btn.Red}" Content="Цэвэрлэх"
                                                Command="{Binding ClearCalibrationCommand}" Margin="8,0,0,0"
                                                Visibility="{Binding IsCalibrated, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Dim}" Margin="27,12,0,0" TextWrapping="Wrap"
                                               Text="Дарахдаа курсорыг агшин зуур (~40мс) нүд рүү аваачиж дараад буцаана — Garena WarKey-тэй яг ижил арга. Тоглоом зөвхөн жинхэнэ курсорын товшилтыг хүлээж авдаг." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Quick chat ===== -->
                <TabItem Header="Quick Chat">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Dim}" Margin="2,0,0,10"
                                       Text="Нэг товч дарахад доорх мессежүүд дараалан илгээгдэнэ. Мөр бүр = нэг мессеж.&#10;&quot;Зөвхөн багтаа&quot; тэмдэглээгүй мессежийг дайсан тоглогчид ч харна." />
                            <ItemsControl ItemsSource="{Binding ChatRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Row}" Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Top" Margin="0,10,0,0" />

                                                <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Top">
                                                    <Button Style="{StaticResource KeyChip}" Content="{Binding HotkeyDisplay}"
                                                            Command="{Binding CaptureHotkeyCommand}" />
                                                    <CheckBox Content="Зөвхөн багтаа" IsChecked="{Binding AlliesOnly}" Margin="0,9,0,0" FontSize="11"
                                                              ToolTip="Тэмдэглэвэл зөвхөн холбоотон харна (Ctrl+Enter).&#10;Тэмдэглээгүй бол дайсан ч харна (Shift+Enter)." />
                                                </StackPanel>

                                                <TextBox Grid.Column="2" Text="{Binding MessagesText, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True" MinHeight="62" TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />

                                                <Button Grid.Column="3" Style="{StaticResource Btn.Ghost}" Content="✕" Margin="10,0,0,0"
                                                        VerticalAlignment="Top"
                                                        Command="{Binding DataContext.RemoveChatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="+  Товч нэмэх" Command="{Binding AddChatCommand}"
                                    HorizontalAlignment="Left" Margin="0,6,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Help ===== -->
                <TabItem Header="Тусламж">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Тоглоом дотроосоо тохируулах" />
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0"
                                               Text="Тоглож байхдаа Ctrl + F6 дар — жижиг самбар тоглоомын дээр гарч ирнэ. Энэ нь фокус булаадаггүй тул тоглоом минимиз болохгүй, alt-tab хийх шаардлагагүй." />
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,0"
                                               Text="Самбар нээлттэй үед: 1-6 дарж эд зүйлийн нүд сонгоод, дараа нь хүссэн товчоо дар. Esc дарж хаана." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Хэрхэн ажилладаг вэ" />
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0"
                                               Text="Энэ апп зөвхөн ТОВЧ СОЛИНО: нэг даралт = нэг үйлдэл. Тоглоом руу код оруулдаггүй, санах ойд хүрдэггүй, автоматаар юу ч хийдэггүй. Garena-гийн сүлжээний давхарга байхгүй тул GameRanger дээр зөрчил үүсгэхгүй." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Чадварын товчийг тоглоом дотроос ч солино" />
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0"
                                               Text="Warcraft III-д CustomKeys.txt гэсэн албан ёсны боломж бий (тоглоомын хавтасны CustomKeyInfo.txt-г уншина уу). Чадварын товчийг тэндээс өөрчилвөл энэ аппгүйгээр ч ажиллана. Эд зүйлийн товчийг харин зөвхөн ийм программаар л солино." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Тохиргоо" />
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0"
                                               Text="%LocalAppData%\LexusWarKey\profile.json — өөрчлөлт болгон шууд хадгалагдана." />
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,0"
                                               Text="Windows-тэй хамт асаах тохиргоо нь зөвхөн таны хэрэглэгчид хамаарна (админ эрх шаардахгүй). Task Manager → Startup хэсгээс ч удирдаж болно." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Шинэчлэлт" />
                                    <CheckBox IsChecked="{Binding AutoInstallUpdates}" Margin="0,10,0,0"
                                              Content="Автоматаар татаад суулгах (асуулгүй)" />
                                    <TextBlock Style="{StaticResource Dim}" Margin="27,5,0,0"
                                               Text="Асаалттай үед апп нээгдэх бүрд шинэ хувилбар байвал өөрөө татаж суулгаад дахин нээгдэнэ. Унтраалттай үед зөвхөн ногоон туузаар санал болгоно." />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Одоо шалгах" Command="{Binding CheckUpdateNowCommand}"
                                                IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InverseBool}}" />
                                        <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource B.Dim}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Бүтээгч" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="Lil" Foreground="{StaticResource B.Red}" FontWeight="Bold" FontSize="15" />
                                        <TextBlock Style="{StaticResource Dim}" Text="  ·  Lexus WarKey" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- key-capture curtain -->
        <Border Grid.RowSpan="2" Background="#B0000000" Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="34,26">
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Товчоо дарна уу" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0" HorizontalAlignment="Center"
                               Text="Esc — болих" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
