<Window x:Class="LexusWarKey.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LexusWarKey.ViewModels"
        Title="Lexus WarKey" Width="620" Height="520" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource B.Bg}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource B.Panel}" Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/app.ico" Width="38" Height="38" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource H1}">
                                <Run Text="Lexus" Foreground="{StaticResource B.Blue}" /><Run Text=" WarKey" />
                            </TextBlock>
                            <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource B.Dim}" FontSize="12"
                                       VerticalAlignment="Bottom" Margin="8,0,0,4" />
                        </StackPanel>
                        <TextBlock Text="Warcraft/Dota 1 skill hotkey remapper" Foreground="{StaticResource B.Dim}" FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" CornerRadius="20" Padding="14,8" VerticalAlignment="Center"
                        Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#2A2724" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsLive}" Value="True">
                                    <Setter Property="Background" Value="#23332A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource B.Dim}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsLive}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource B.Ok}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="12"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                        <TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource B.Dim}" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,1,0,0" MaxWidth="190"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22,16,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="8" Background="{StaticResource B.RedDim}" BorderBrush="{StaticResource B.Red}"
                    BorderThickness="1" Padding="14,11" Margin="0,0,0,12"
                    Visibility="{Binding HasProblems, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Attention" Foreground="{StaticResource B.Red}"
                               FontWeight="Bold" FontSize="13" />
                    <TextBlock Text="{Binding ProblemText}" Foreground="{StaticResource B.Text}" FontSize="12"
                               Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TabControl Grid.Row="1">
                <TabItem Header="Warkey">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <Border Style="{StaticResource Card}" Padding="16,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource PanelTitle}" Text="Skill hotkeys" DockPanel.Dock="Left"
                                               HorizontalAlignment="Left" Margin="0" />
                                    <CheckBox IsChecked="{Binding IsEnabled}" Content="Enabled"
                                              HorizontalAlignment="Right" DockPanel.Dock="Right" />
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding SkillRows}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Row}" Padding="10" Margin="4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource B.Dim}"
                                                               FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,5" />
                                                    <Button Style="{StaticResource KeyChip}" Content="{Binding FromDisplay}"
                                                            MinWidth="82" Command="{Binding CaptureFromCommand}"
                                                            ToolTip="Your key. Click, then press the key. Backspace clears." />
                                                    <Button Style="{StaticResource CellChip.Target}" Content="{Binding ToDisplay}"
                                                            Margin="0,4,0,0" Command="{Binding CaptureToCommand}"
                                                            ToolTip="Warcraft letter for this skill. Click, then press the letter." />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="QuickChat">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding ChatRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Row}" Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                                                           FontWeight="SemiBold" />
                                                <Button Grid.Column="1" Style="{StaticResource KeyChip}" Content="{Binding HotkeyDisplay}"
                                                        MinWidth="92" Margin="0,0,12,0"
                                                        Command="{Binding CaptureHotkeyCommand}"
                                                        ToolTip="Trigger key. Click, then press the key. Backspace clears." />
                                                <TextBox Grid.Column="2" Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                                                         VerticalContentAlignment="Center" MaxLines="1"
                                                         FontFamily="Consolas" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.RowSpan="2" Background="#B0000000" Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="34,26">
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Press a key" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0" HorizontalAlignment="Center"
                               Text="Esc cancels - Backspace clears" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
