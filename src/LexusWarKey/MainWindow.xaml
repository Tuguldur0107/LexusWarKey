<Window x:Class="LexusWarKey.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LexusWarKey.ViewModels"
        Title="Lexus WarKey" Width="820" Height="700" MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource B.Bg}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Background="{StaticResource B.Panel}" Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource H1}">
                            <Run Text="Lexus" Foreground="{StaticResource B.Accent}" /><Run Text=" WarKey" />
                        </TextBlock>
                        <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource B.Dim}" FontSize="12"
                                   VerticalAlignment="Bottom" Margin="8,0,0,4" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Dim}" Margin="0,2,0,0"
                               Text="Эд зүйл • Чадвар • Quick Chat — Garena шаардлагагүй" />
                </StackPanel>

                <!-- status pill -->
                <Border Grid.Column="1" CornerRadius="20" Padding="14,8" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#2A2724" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsLive}" Value="True">
                                    <Setter Property="Background" Value="#23332A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource B.Dim}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsLive}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource B.Ok}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource B.Dim}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Body ===== -->
        <Grid Grid.Row="1" Margin="22,16,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- toggles -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12">
                <StackPanel Orientation="Horizontal">
                    <CheckBox IsChecked="{Binding IsEnabled}" Content="Идэвхтэй" FontWeight="SemiBold" />
                    <TextBlock Text="Ctrl + F5" Foreground="{StaticResource B.Dim}" FontSize="11" VerticalAlignment="Center" Margin="8,1,0,0" />
                    <Rectangle Width="1" Fill="{StaticResource B.Border}" Margin="20,2" />
                    <CheckBox IsChecked="{Binding OnlyWhenGameFocused}" Content="Зөвхөн Warcraft дотор" />
                    <Rectangle Width="1" Fill="{StaticResource B.Border}" Margin="20,2" />
                    <TextBlock Text="Тоглоом дотор тохируулах: Ctrl + F6" Foreground="{StaticResource B.Dim}"
                               FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1">
                <!-- update banner -->
                <Border CornerRadius="8" Background="#243328" Padding="14,11" Margin="0,10,0,0"
                        Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UpdateText}" Foreground="{StaticResource B.Ok}" FontWeight="SemiBold" FontSize="13" />
                            <ProgressBar Height="4" Margin="0,8,0,0" Minimum="0" Maximum="1"
                                         Value="{Binding UpdateProgress, Mode=OneWay}" Foreground="{StaticResource B.Ok}"
                                         Background="#1A1817" BorderThickness="0"
                                         Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource Btn.Ghost}" Content="Юу шинэчлэгдсэн?" Command="{Binding OpenReleasePageCommand}" />
                            <Button Style="{StaticResource Btn.Accent}" Content="Шинэчлэх" Margin="8,0,0,0"
                                    Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding IsUpdating, Converter={StaticResource InverseBool}}" />
                            <Button Style="{StaticResource Btn.Ghost}" Content="✕" Margin="4,0,0,0" Command="{Binding DismissUpdateCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- conflict warning -->
                <Border CornerRadius="8" Background="#3A2F1E" Padding="12,9" Margin="0,10,0,0"
                        Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ConflictText}" Foreground="{StaticResource B.Warn}" FontSize="12" />
                </Border>
            </StackPanel>

            <TabControl Grid.Row="2" Margin="0,14,0,0">

                <!-- ===== Inventory: Warcraft's own 2x3 grid ===== -->
                <TabItem Header="Эд зүйл">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Dim}" Margin="2,0,0,12"
                                       Text="Байрлал нь тоглоомын цүнхтэй яг адил (2×3). Дээд том товч = таны дарах товч. Доод жижиг нь Warcraft-ын өөрийнх нь товч." />
                            <ItemsControl ItemsSource="{Binding InventoryRows}" HorizontalAlignment="Left" Width="360">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource GridCell}">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="{Binding Label}" Foreground="#6E6A63" FontSize="11"
                                                               HorizontalAlignment="Left" />
                                                    <CheckBox IsChecked="{Binding Enabled}" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Button Style="{StaticResource CellChip}" Content="{Binding FromDisplay}"
                                                        Command="{Binding CaptureFromCommand}" Margin="0,6,0,0" />
                                                <Button Style="{StaticResource CellChip.Target}" Content="{Binding ToDisplay}"
                                                        Command="{Binding CaptureToCommand}" Margin="0,3,0,0"
                                                        ToolTip="Warcraft-ын товч — ихэвчлэн хөндөхгүй" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Skills: the 4x3 command card ===== -->
                <TabItem Header="Чадвар">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <!-- position mode + calibration -->
                            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding SkillsUsePosition}" FontWeight="SemiBold"
                                              Content="Байрлалаар дарах (LoD / random чадварт зориулсан)" />
                                    <TextBlock Style="{StaticResource Dim}" Margin="27,6,0,0"
                                               Text="Асаалттай үед: таны товч дарахад тухайн БАЙРЛАЛД байгаа чадвар дарагдана — үсэг нь юу ч байсан хамаагүй. LoD шиг санамсаргүй чадвартай горимд яг үүнийг л хэрэгтэй." />
                                    <TextBlock Style="{StaticResource Dim}" Margin="27,6,0,0" Foreground="{StaticResource B.Warn}"
                                               Text="{Binding CalibrationText}" />
                                    <StackPanel Orientation="Horizontal" Margin="27,10,0,0">
                                        <Button Style="{StaticResource Btn.Accent}" Content="Командын карт тохируулах"
                                                Command="{Binding CalibrateCommand}" />
                                        <Button Content="Цэвэрлэх" Command="{Binding ClearCalibrationCommand}" Margin="8,0,0,0"
                                                Visibility="{Binding IsCalibrated, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <CheckBox IsChecked="{Binding MoveCursorForClicks}" Margin="27,12,0,0"
                                              Content="Курсор хөдөлгөж дарах (зөвхөн дээрх арга ажиллахгүй бол)" />
                                    <TextBlock Style="{StaticResource Dim}" Margin="27,5,0,0"
                                               Text="Анхдагчаар товшилтыг тоглоомын цонх руу шууд илгээдэг тул ТАНЫ КУРСОР ОГТ ХӨДӨЛДӨГГҮЙ. Энэ сонголтыг зөвхөн чадвар ажиллахгүй байвал асаа — тэр үед курсор хормын зуур очоод буцна." />
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource Dim}" Margin="2,0,0,12"
                                       Text="Байрлал нь тоглоомын командын карттай адил (4×3). Дээд том товч = таны дарах товч. Alt+товч = auto-cast (баруун товшилт), Ctrl+товч = чадвар сурах." />
                            <ItemsControl ItemsSource="{Binding SkillRows}" HorizontalAlignment="Left" Width="600">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource GridCell}">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="{Binding Label}" Foreground="#6E6A63" FontSize="11"
                                                               HorizontalAlignment="Left" />
                                                    <CheckBox IsChecked="{Binding Enabled}" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Button Style="{StaticResource CellChip}" Content="{Binding FromDisplay}"
                                                        Command="{Binding CaptureFromCommand}" Margin="0,6,0,0" />
                                                <Button Style="{StaticResource CellChip.Target}" Content="{Binding ToDisplay}"
                                                        Command="{Binding CaptureToCommand}" Margin="0,3,0,0"
                                                        ToolTip="Тоглоом дээрх чадварын үсэг" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Quick chat ===== -->
                <TabItem Header="Quick Chat">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Dim}" Margin="2,0,0,10"
                                       Text="Нэг товч дарахад доорх мессежүүд дараалан илгээгдэнэ. Мөр бүр = нэг мессеж." />
                            <ItemsControl ItemsSource="{Binding ChatRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Row}" Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Top" Margin="0,10,0,0" />

                                                <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Top">
                                                    <Button Style="{StaticResource KeyChip}" Content="{Binding HotkeyDisplay}"
                                                            Command="{Binding CaptureHotkeyCommand}" />
                                                    <CheckBox Content="Холбоотонд" IsChecked="{Binding AlliesOnly}" Margin="0,9,0,0" FontSize="11" />
                                                </StackPanel>

                                                <TextBox Grid.Column="2" Text="{Binding MessagesText, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True" MinHeight="62" TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />

                                                <Button Grid.Column="3" Style="{StaticResource Btn.Ghost}" Content="✕" Margin="10,0,0,0"
                                                        VerticalAlignment="Top"
                                                        Command="{Binding DataContext.RemoveChatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="+  Товч нэмэх" Command="{Binding AddChatCommand}"
                                    HorizontalAlignment="Left" Margin="0,6,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Help ===== -->
                <TabItem Header="Тусламж">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Тоглоом дотроосоо тохируулах" />
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0"
                                               Text="Тоглож байхдаа Ctrl + F6 дар — жижиг самбар тоглоомын дээр гарч ирнэ. Энэ нь фокус булаадаггүй тул тоглоом минимиз болохгүй, alt-tab хийх шаардлагагүй." />
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,0"
                                               Text="Самбар нээлттэй үед: 1-6 дарж эд зүйлийн нүд сонгоод, дараа нь хүссэн товчоо дар. Esc дарж хаана." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Хэрхэн ажилладаг вэ" />
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0"
                                               Text="Энэ апп зөвхөн ТОВЧ СОЛИНО: нэг даралт = нэг үйлдэл. Тоглоом руу код оруулдаггүй, санах ойд хүрдэггүй, автоматаар юу ч хийдэггүй. Garena-гийн сүлжээний давхарга байхгүй тул GameRanger дээр зөрчил үүсгэхгүй." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Чадварын товчийг тоглоом дотроос ч солино" />
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0"
                                               Text="Warcraft III-д CustomKeys.txt гэсэн албан ёсны боломж бий (тоглоомын хавтасны CustomKeyInfo.txt-г уншина уу). Чадварын товчийг тэндээс өөрчилвөл энэ аппгүйгээр ч ажиллана. Эд зүйлийн товчийг харин зөвхөн ийм программаар л солино." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Тохиргоо" />
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0"
                                               Text="%LocalAppData%\LexusWarKey\profile.json — өөрчлөлт болгон шууд хадгалагдана." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- key-capture curtain -->
        <Border Grid.RowSpan="2" Background="#B0000000" Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="34,26">
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Товчоо дарна уу" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0" HorizontalAlignment="Center"
                               Text="Esc — болих" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
