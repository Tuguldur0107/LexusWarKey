<Window x:Class="LexusWarKey.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LexusWarKey.ViewModels"
        Title="Lexus WarKey" Width="760" Height="620" MinWidth="700" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource B.Bg}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Background="{StaticResource B.Panel}" Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/app.ico" Width="40" Height="40" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,14,0" />
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource H1}">
                                <Run Text="Lexus" Foreground="{StaticResource B.Blue}" /><Run Text=" WarKey" />
                            </TextBlock>
                            <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource B.Dim}" FontSize="12"
                                       VerticalAlignment="Bottom" Margin="8,0,0,4" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="Бүтээгч " Foreground="{StaticResource B.Dim}" FontSize="12" />
                            <TextBlock Text="Lil" Foreground="{StaticResource B.Red}" FontSize="12" FontWeight="Bold" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- manual update check: always one click away, not buried in a tab -->
                <Button Grid.Column="1" VerticalAlignment="Center"
                        Margin="0,0,14,0" Command="{Binding CheckUpdateNowCommand}"
                        ToolTip="GitHub-аас шинэ хувилбар байгаа эсэхийг шалгана">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCheckingUpdate}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="⟳ Шинэчлэлт шалгах" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCheckingUpdate}" Value="True">
                                        <Setter Property="Text" Value="Шалгаж байна…" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <!-- status pill -->
                <Border Grid.Column="2" CornerRadius="20" Padding="14,8" VerticalAlignment="Center"
                        Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#2A2724" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsLive}" Value="True">
                                    <Setter Property="Background" Value="#23332A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource B.Dim}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsLive}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource B.Ok}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="12"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                        <TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource B.Dim}" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,1,0,0" MaxWidth="230"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusDetail}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Body ===== -->
        <Grid Grid.Row="1" Margin="22,16,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <!-- activation banner: the app is for the Lexus Discord community -->
                <Border CornerRadius="8" Background="#2A2416" BorderBrush="{StaticResource B.Warn}"
                        BorderThickness="1" Padding="14,11" Margin="0,10,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NeedsActivationAttention}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource B.Warn}" FontWeight="Bold" FontSize="13"
                                   Text="{Binding ActivationHeading}" />
                        <TextBlock Foreground="{StaticResource B.Text}" FontSize="12" Margin="0,4,0,6" TextWrapping="Wrap"
                                   Text="Энэ апп Lexus Discord серверийн гишүүдэд зориулагдсан (tier-тэй байх шаардлагатай). Код зөвхөн ЭНЭ компьютерт ажиллана — бусдад тарааж болохгүй." />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Foreground="{StaticResource B.Dim}" FontSize="12" VerticalAlignment="Center"
                                       Text="1) Discord дээрээ энэ мөрийг бич: " />
                            <Border Background="#1A1817" CornerRadius="4" Padding="8,3">
                                <TextBox Text="{Binding ActivationCommand, Mode=OneWay}" IsReadOnly="True"
                                         Background="Transparent" BorderThickness="0" FontFamily="Consolas"
                                         Foreground="{StaticResource B.Ok}" FontSize="12" />
                            </Border>
                            <TextBlock Foreground="{StaticResource B.Dim}" FontSize="12" VerticalAlignment="Center"
                                       Text="   2) ирсэн кодоо доор буулга" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="420" Text="{Binding ActivationInput, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" MaxLines="1" />
                            <Button Style="{StaticResource Btn.Accent}" Content="Идэвхжүүлэх" Margin="8,0,0,0"
                                    Command="{Binding ActivateCommand}" />
                        </StackPanel>
                        <TextBlock Foreground="{StaticResource B.Red}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="{Binding ActivationStatus}" />
                    </StackPanel>
                </Border>

                <!-- update banner -->
                <Border CornerRadius="8" Background="#243328" Padding="14,11" Margin="0,10,0,0"
                        Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UpdateText}" Foreground="{StaticResource B.Ok}" FontWeight="SemiBold" FontSize="13" />
                            <ProgressBar Height="4" Margin="0,8,0,0" Minimum="0" Maximum="1"
                                         Value="{Binding UpdateProgress, Mode=OneWay}" Foreground="{StaticResource B.Ok}"
                                         Background="#1A1817" BorderThickness="0"
                                         Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Btn.Ghost}" Content="Юу шинэчлэгдсэн?" Command="{Binding OpenReleasePageCommand}" />
                            <Button Style="{StaticResource Btn.Accent}" Content="Шинэчлэх" Margin="8,0,0,0"
                                    Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding IsUpdating, Converter={StaticResource InverseBool}}" />
                            <Button Style="{StaticResource Btn.Ghost}" Content="✕" Margin="4,0,0,0" Command="{Binding DismissUpdateCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- everything that needs attention, in one place and in severity order -->
                <Border CornerRadius="8" Background="{StaticResource B.RedDim}" BorderBrush="{StaticResource B.Red}"
                        BorderThickness="1" Padding="14,11" Margin="0,10,0,0"
                        Visibility="{Binding HasProblems, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Анхаарах зүйл" Foreground="{StaticResource B.Red}"
                                   FontWeight="Bold" FontSize="13" />
                        <TextBlock Text="{Binding ProblemText}" Foreground="{StaticResource B.Text}" FontSize="12"
                                   Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <TabControl Grid.Row="1" Margin="0,14,0,0">

                <!-- ===== Keys: inventory and skills side by side, like the game ===== -->
                <TabItem Header="Товч">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">

                                <!-- Inventory 2x3 -->
                                <Border Style="{StaticResource Card}" Padding="16,14" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PanelTitle}" Text="Эд зүйл" />
                                        <ItemsControl ItemsSource="{Binding InventoryRows}" Width="180">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource SlotButton}" Content="{Binding FromDisplay}"
                                                            Tag="{Binding Label}"
                                                            Command="{Binding CaptureFromCommand}"
                                                            ToolTip="Дараад шинэ товчоо дар · Backspace = цэвэрлэх" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Skills: the full 4x3 command card, same shape as the game -->
                                <Border Style="{StaticResource Card}" Padding="16,14" Margin="14,0,0,0" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PanelTitle}" Text="Командын карт" />
                                        <ItemsControl ItemsSource="{Binding SkillRows}" Width="360">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <Button Style="{StaticResource SlotButton}" Content="{Binding FromDisplay}"
                                                                Tag="{Binding Label}"
                                                                Command="{Binding CaptureFromCommand}"
                                                                ToolTip="Дараад шинэ товчоо дар · Backspace = цэвэрлэх" />
                                                        <Button Style="{StaticResource KeyChip}" Content="{Binding ToDisplay}"
                                                                Margin="0,2,0,4" HorizontalAlignment="Center"
                                                                Command="{Binding CaptureToCommand}"
                                                                ToolTip="Энэ нүдний ТОГЛООМЫН үсэг (CustomKeys) — апп клик хийхийн оронд энэ үсгийг илгээнэ.&#10;Дараад үсгээ дар · Backspace = клик горимд буцаах (—)"
                                                                Visibility="{Binding DataContext.UseGameLetters, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <CheckBox Content="CustomKeys горим — клик биш, үсэг илгээх" IsChecked="{Binding UseGameLetters}"
                                                  Margin="0,10,0,0" FontSize="11"
                                                  ToolTip="Тоглоомын хавтсанд CustomKeys.txt суулгаж, Options → Gameplay → Custom Keyboard Shortcuts асаасан үед л хэрэглэнэ.&#10;Нүд бүр өөрийн тоглоомын үсэгтэй болж, апп курсор хөдөлгөлгүй тэр үсгийг илгээнэ.&#10;Үсэг нь давхцсан нүдийг «—» (клик) горимд үлдээж болно." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Only speaks when the card is not linked. Undoing a good link is
                                 a maintenance action, so it lives in Тохиргоо, not here. -->
                            <Border Padding="16,12" Margin="0,14,0,0">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCalibrated}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding CalibrationText}" TextWrapping="Wrap"
                                           Foreground="{StaticResource B.Warn}" FontSize="12" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Quick chat ===== -->
                <TabItem Header="Quick Chat">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Dim}" Margin="2,0,0,10"
                                       Text="Нэг товч дарахад доорх мессежүүд дараалан илгээгдэнэ. Мөр бүр = нэг мессеж.&#10;&quot;Зөвхөн багтаа&quot; тэмдэглээгүй мессежийг дайсан тоглогчид ч харна." />
                            <ItemsControl ItemsSource="{Binding ChatRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Row}" Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Top" Margin="0,10,0,0" />

                                                <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Top">
                                                    <Button Style="{StaticResource KeyChip}" Content="{Binding HotkeyDisplay}"
                                                            Command="{Binding CaptureHotkeyCommand}" />
                                                    <CheckBox Content="Зөвхөн багтаа" IsChecked="{Binding AlliesOnly}" Margin="0,9,0,0" FontSize="11"
                                                              ToolTip="Тэмдэглэвэл зөвхөн холбоотон харна (Ctrl+Enter).&#10;Тэмдэглээгүй бол дайсан ч харна (Shift+Enter)." />
                                                </StackPanel>

                                                <TextBox Grid.Column="2" Text="{Binding MessagesText, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True" MinHeight="62" TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />

                                                <Button Grid.Column="3" Style="{StaticResource Btn.Ghost}" Content="✕" Margin="10,0,0,0"
                                                        VerticalAlignment="Top"
                                                        Command="{Binding DataContext.RemoveChatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="+  Товч нэмэх" Command="{Binding AddChatCommand}"
                                    HorizontalAlignment="Left" Margin="0,6,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Help ===== -->
                <TabItem Header="Тусламж">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Тоглоом дотроосоо тохируулах" />
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Text="Тоглож байхдаа Ctrl + F6 дар — жижиг самбар тоглоомын дээр гарч ирнэ. Фокус булаадаггүй тул тоглоом минимиз болохгүй, alt-tab хийх шаардлагагүй." />
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="Нүд дээр дараад (эсвэл 1–6 дарж эд зүйлийн нүд сонгоод) хүссэн товчоо дар. Backspace = нүд цэвэрлэх, Esc = болих." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Чадварыг байрлалаар дарах (LoD)" />
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Text="LoD-д чадвар санамсаргүй ирдэг тул үсэг нь урьдчилан мэдэгддэггүй. Тиймээс товч чинь үсгийг нь биш, командын картын НҮДИЙГ дардаг." />
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="Нэг удаа холбоно: Ctrl + F6 → самбарын торыг тоглоомын командын карт дээр яг давхарла (◢ булангаар хэмжээг нь тааруул) → 🔗 Холбох. Дараа нь 📍 Шалгах · Засах дарж цагираг бүр өөрийн нүдэн дээрээ буусныг хараарай; буруу байвал чирээд 💾 Хадгална." />
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="Доод эгнээ (9–12) = үндсэн чадварууд. LoD-ийн 5, 6 дахь чадвар дунд эгнээний баруун хоёр нүдэнд (7–8) ордог." />
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="Товчоо дарахдаа Alt барих = Auto-Cast, Ctrl барих = тэр чадварыг сурах." />
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="Хулганы дугуй (↑/↓), дунд товч, хажуугийн 4/5 товчийг ч оноож болно — нүд дээр дараад тэр товчоо дарахад л хангалттай. Оноогоогүй бол дугуй хэвээрээ камер ойртуулна." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Чат бичихэд юу болдог вэ" />
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Text="Enter дарж тоглоомын чат нээхэд товч солилт автоматаар зогсдог тул бичсэн үсэг чинь хэвээрээ ордог. Enter (илгээх) эсвэл Esc (болих) дарахад буцаад асна — толгойд «Чат нээлттэй» гэж харагдана." />
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="Quick Chat дээр «Зөвхөн багтаа» тэмдэглэвэл зөвхөн холбоотон харна (Ctrl+Enter), эс тэмдэглэвэл дайсан ч харна (Shift+Enter)." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Хэрхэн ажилладаг вэ" />
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Text="Энэ апп зөвхөн ТОВЧ СОЛИНО: нэг даралт = нэг үйлдэл. Тоглоом руу код оруулдаггүй, санах ойд хүрдэггүй, автоматаар юу ч хийдэггүй. Garena-гийн сүлжээний давхарга байхгүй тул GameRanger дээр зөрчил үүсгэхгүй." />
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="Warcraft III-д CustomKeys.txt гэсэн албан ёсны боломж бий (тоглоомын хавтасны CustomKeyInfo.txt-г уншина уу). Чадварын товчийг тэндээс өөрчилвөл энэ аппгүйгээр ч ажиллана, гэхдээ LoD шиг санамсаргүй чадвартай горимд тохирдоггүй. Эд зүйлийн товчийг харин зөвхөн ийм программаар л солино." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Бүтээгч" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="Lil" Foreground="{StaticResource B.Red}" FontWeight="Bold" FontSize="15" />
                                        <TextBlock Style="{StaticResource Dim}" Text="  ·  Lexus WarKey" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Тохиргоо">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <!-- The switches that used to sit in a strip above the tabs, where the
                                 labels alone had to carry what each one does. -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Ажиллагаа" />

                                    <CheckBox IsChecked="{Binding IsEnabled}" Content="Идэвхтэй" FontWeight="SemiBold" Margin="0,12,0,0" />
                                    <TextBlock Style="{StaticResource Dim}" Margin="27,4,0,0" TextWrapping="Wrap"
                                               Text="Унтраавал ямар ч товч солигдохгүй — апп бүрэн хөндлөнгөөс оролцохоо болино." />

                                    <CheckBox IsChecked="{Binding OnlyWhenGameFocused}" Content="Зөвхөн Warcraft дотор" Margin="0,14,0,0" />
                                    <TextBlock Style="{StaticResource Dim}" Margin="27,4,0,0" TextWrapping="Wrap"
                                               Text="Асаалттай үед товч солилт зөвхөн тоглоом фокуст байхад ажиллана. Хөтөч, Discord зэрэгт огт нөлөөлөхгүй — үүнийг унтраахыг зөвлөхгүй." />

                                    <CheckBox IsChecked="{Binding StartWithWindows}" Content="Windows-тэй хамт асаах" Margin="0,14,0,0" />
                                    <TextBlock Style="{StaticResource Dim}" Margin="27,4,0,0" TextWrapping="Wrap"
                                               Text="Зөвхөн таны хэрэглэгчид хамаарна (админ эрх шаардахгүй). Task Manager → Startup хэсгээс ч удирдаж болно." />

                                    <CheckBox IsChecked="{Binding MinimiseToTray}" Content="Хаахад tray-д үлдэх" Margin="0,14,0,0" />
                                    <TextBlock Style="{StaticResource Dim}" Margin="27,4,0,0" TextWrapping="Wrap"
                                               Text="Цонхыг хаахад апп taskbar-аас алга болж, цагны хажууд үлдэн ажилласаар байна. Дүрс дээр 2 дарж нээнэ, баруун товчоор бүрэн гарна." />

                                    <CheckBox IsChecked="{Binding PostClicksToGameWindow}" Content="Skill товч дарахад курсор хөдөлгөхгүй (туршилтын)" Margin="0,14,0,0" />
                                    <TextBlock Style="{StaticResource Dim}" Margin="27,4,0,0" TextWrapping="Wrap"
                                               Text="Skill slot дээр товч дарахад курсор нүд рүү очиж дараад буцахын оронд, click мессежийг шууд тоглоомын цонхонд илгээнэ — курсор огт хөдлөхгүй тул 1 frame gүйх байхгүй болно. Warcraft posted click хүлээж авахгүй машинуудад ажиллахгүй байж болзошгүй тул туршиж үзнэ үү. Асуудалтай бол унтраахад өмнөх (курсортой) арга руу буцна." />
                                </StackPanel>
                            </Border>

                            <!-- Always reachable, so a code can be renewed before anything expires -->
                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Идэвхжүүлэлт" />
                                    <TextBlock Text="{Binding ActivationSummary}" Foreground="{StaticResource B.Dim}"
                                               FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Foreground="{StaticResource B.Dim}" FontSize="12" VerticalAlignment="Center"
                                                   Text="Lexus Discord server дээр бич: " />
                                        <Border Background="#1A1817" CornerRadius="4" Padding="8,3">
                                            <TextBox Text="{Binding ActivationCommand, Mode=OneWay}" IsReadOnly="True"
                                                     Background="Transparent" BorderThickness="0" FontFamily="Consolas"
                                                     Foreground="{StaticResource B.Ok}" FontSize="12" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Text="Ботоос ирсэн кодоо доор буулгаад Хадгална уу. Код зөвхөн энэ компьютерт ажиллана." />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBox Width="420" Text="{Binding ActivationInput, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalContentAlignment="Center" MaxLines="1" />
                                        <Button Style="{StaticResource Btn.Accent}" Content="Кодоо хадгалах" Margin="8,0,0,0"
                                                Command="{Binding ActivateCommand}" />
                                    </StackPanel>
                                    <TextBlock Foreground="{StaticResource B.Red}" FontSize="12" Margin="0,6,0,0"
                                               TextWrapping="Wrap" Text="{Binding ActivationStatus}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Шинэчлэлт" />
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Text="Шинэчлэлт автоматаар суудаг: апп нээгдэх бүрд шалгаад, шинэ хувилбар байвал өөрөө татаж суулгаад дахин нээгдэнэ. Тохиргоо чинь хэвээр үлддэг. Бүх гишүүн ижил хувилбартай байх ёстой тул үүнийг унтраах боломжгүй." />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Одоо шалгах" Command="{Binding CheckUpdateNowCommand}"
                                                IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InverseBool}}" />
                                        <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource B.Dim}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Командын карт" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock VerticalAlignment="Center" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Холбоогүй" />
                                                    <Setter Property="Foreground" Value="{StaticResource B.Warn}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCalibrated}" Value="True">
                                                            <Setter Property="Text" Value="✓ Холбогдсон" />
                                                            <Setter Property="Foreground" Value="{StaticResource B.Ok}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Style="{StaticResource Btn.Ghost}" Content="Холболтыг цуцлах" Margin="12,0,0,0"
                                                Command="{Binding ClearCalibrationCommand}"
                                                Visibility="{Binding IsCalibrated, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Дэлгэц" />
                                    <TextBlock Text="{Binding DisplayInfo}" Foreground="{StaticResource B.Dim}"
                                               FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="Асуудал мэдээлэхдээ энэ мөрийг хамт явуулаарай. Нягтрал эсвэл цонхны горим өөрчлөгдвөл карт өөрөө дагаж шилжинэ." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Файлууд" />
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Text="Тохиргоо: %LocalAppData%\LexusWarKey\profile.json — өөрчлөлт болгон шууд хадгалагдаж, нөөц хувь нь profile.backup.json-д үлддэг." />
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="Асуудал гарвал: %LocalAppData%\LexusWarKey\diagnostic.log — юу болсныг эндээс харна." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- key-capture curtain -->
        <Border Grid.RowSpan="2" Background="#B0000000" Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="34,26">
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Товчоо дарна уу" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0" HorizontalAlignment="Center"
                               Text="Esc — болих" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
