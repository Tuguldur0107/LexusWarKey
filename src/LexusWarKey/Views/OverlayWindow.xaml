<Window x:Class="LexusWarKey.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lexus WarKey overlay"
        Width="330" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True">

    <Border Background="#F21F1C1A" CornerRadius="12" BorderBrush="#D97757" BorderThickness="1" Padding="16">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Lexus" Foreground="#D97757" FontWeight="Bold" FontSize="14" />
                <TextBlock Text=" WarKey" Foreground="#EFEDE8" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="Ctrl+F6 хаах" Foreground="#9C978D" FontSize="11" VerticalAlignment="Center"
                           Margin="12,2,0,0" />
            </StackPanel>

            <TextBlock x:Name="PromptText" Foreground="#DDA85C" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                       Text="1–6 дарж нүд сонго" />

            <ItemsControl x:Name="SlotList" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="7" Padding="10,7" Margin="0,0,0,5"
                                Background="{Binding RowBackground}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Number}" Foreground="#9C978D" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#EFEDE8" FontSize="12" />
                                <Border Grid.Column="2" Background="#2A2724" CornerRadius="5" Padding="9,3">
                                    <TextBlock Text="{Binding KeyName}" Foreground="#EFEDE8" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Foreground="#6E6A63" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Тоглоом фокусаа алдахгүй — энэ самбар фокус авдаггүй." />
        </StackPanel>
    </Border>
</Window>
