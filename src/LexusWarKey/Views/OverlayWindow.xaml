<Window x:Class="LexusWarKey.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lexus WarKey overlay"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True">

    <!-- Black at 50% (80 = 128/255): the fight stays readable through the panel. -->
    <Border Background="#80000000" CornerRadius="10" BorderBrush="#59FFFFFF" BorderThickness="1" Padding="10">
        <StackPanel>

            <!-- drag handle -->
            <Border x:Name="DragHandle" Background="#01FFFFFF" Cursor="SizeAll" Padding="2,0,2,6">
                <Grid>
                    <TextBlock Text="⠿  Lexus WarKey" Foreground="#B3FFFFFF" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock x:Name="PromptText" Foreground="#FFFFFF" FontSize="11"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               MaxWidth="330" TextTrimming="CharacterEllipsis" Text="" />
                </Grid>
            </Border>

            <!-- grids, laid out like the game: inventory 2x3, command card 4x3 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <ItemsControl x:Name="InventoryList" VerticalAlignment="Bottom">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2" CornerRadius="5" Cursor="Hand"
                                    Background="{Binding Background}" BorderBrush="{Binding Border}" BorderThickness="1.5"
                                    Tag="{Binding}" MouseLeftButtonDown="Slot_Click">
                                <Grid>
                                    <TextBlock Text="{Binding Number}" Foreground="#59FFFFFF" FontSize="9"
                                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,2,0,0" />
                                    <TextBlock Text="{Binding KeyName}" Foreground="#FFFFFF" FontSize="13"
                                               FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl x:Name="SkillList" Margin="12,0,0,0" VerticalAlignment="Bottom">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2" CornerRadius="5" Cursor="Hand"
                                    Background="{Binding Background}" BorderBrush="{Binding Border}" BorderThickness="1.5"
                                    Tag="{Binding}" MouseLeftButtonDown="Slot_Click">
                                <Grid>
                                    <TextBlock Text="{Binding Number}" Foreground="#59FFFFFF" FontSize="9"
                                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,2,0,0" />
                                    <TextBlock Text="{Binding KeyName}" Foreground="#FFFFFF" FontSize="13"
                                               FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- One button row. While the rings are being adjusted it becomes their controls,
                 so adjusting never opens a window of its own. -->
            <Grid Margin="2,8,0,0">
                <StackPanel x:Name="NormalButtons" Orientation="Horizontal">
                    <Border Background="#26FFFFFF" CornerRadius="5" Cursor="Hand"
                            BorderBrush="#80FFFFFF" BorderThickness="1" Padding="12,6"
                            MouseLeftButtonDown="Link_Click"
                            ToolTip="Энэ торыг тоглоомын командын карт дээр яг давхарлаад дар">
                        <TextBlock Text="🔗 Холбох" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <Border Background="#26FFFFFF" CornerRadius="5" Cursor="Hand"
                            BorderBrush="#80FFFFFF" BorderThickness="1" Padding="12,6" Margin="6,0,0,0"
                            MouseLeftButtonDown="Markers_Click"
                            ToolTip="Нүд бүрийг чухам хаана дарахыг цагирагаар харуулна">
                        <TextBlock Text="📍 Засах" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <StackPanel x:Name="AdjustButtons" Orientation="Horizontal" Visibility="Collapsed">
                    <Border Background="#2E5C34" CornerRadius="5" Cursor="Hand"
                            BorderBrush="#80FFFFFF" BorderThickness="1" Padding="12,6"
                            MouseLeftButtonDown="AdjustSave_Click">
                        <TextBlock Text="💾 Хадгалах" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <Border Background="#2E4A5C" CornerRadius="5" Cursor="Hand"
                            BorderBrush="#80FFFFFF" BorderThickness="1" Padding="12,6" Margin="6,0,0,0"
                            MouseLeftButtonDown="AdjustTidy_Click">
                        <TextBlock Text="▦ Цэгцлэх" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <Border Background="#5C2E2E" CornerRadius="5" Cursor="Hand"
                            BorderBrush="#80FFFFFF" BorderThickness="1" Padding="12,6" Margin="6,0,0,0"
                            MouseLeftButtonDown="AdjustCancel_Click">
                        <TextBlock Text="✕ Болих" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <Thumb x:Name="ResizeGrip" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Width="20" Height="20" Cursor="SizeNWSE">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="#01FFFFFF">
                                <TextBlock Text="◢" Foreground="#80FFFFFF" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </StackPanel>
    </Border>
</Window>
