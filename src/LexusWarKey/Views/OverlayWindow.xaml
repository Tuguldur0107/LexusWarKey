<Window x:Class="LexusWarKey.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lexus WarKey overlay"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True">

    <!-- Pure black at 80% so the game stays readable behind it (CC = 204/255). -->
    <Border Background="#CC000000" CornerRadius="12" BorderBrush="#66FFFFFF" BorderThickness="1" Padding="14">
        <StackPanel>

            <!-- drag handle -->
            <Border x:Name="DragHandle" Background="#01FFFFFF" Cursor="SizeAll" Padding="2,0,2,8">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⠿" Foreground="#80FFFFFF" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Lexus WarKey" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" />
                    </StackPanel>
                    <TextBlock Text="чирж зөөнө · Ctrl+F6 хаах" Foreground="#80FFFFFF" FontSize="10"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock x:Name="PromptText" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"
                       Margin="2,0,0,10" TextWrapping="Wrap" MaxWidth="560"
                       Text="Нүд дээр дар, дараа нь товчоо дар" />

            <!-- grids, laid out like the game: inventory 2x3, command card 4x3 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="Эд зүйл" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <ItemsControl x:Name="InventoryList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="2" CornerRadius="6" Cursor="Hand"
                                        Background="{Binding Background}" BorderBrush="{Binding Border}" BorderThickness="1.5"
                                        Tag="{Binding}" MouseLeftButtonDown="Slot_Click">
                                    <Grid>
                                        <TextBlock Text="{Binding Number}" Foreground="#59FFFFFF" FontSize="9"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,2,0,0" />
                                        <TextBlock Text="{Binding KeyName}" Foreground="#FFFFFF" FontSize="13"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Margin="16,0,0,0" VerticalAlignment="Bottom">
                    <TextBlock Text="Командын карт" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <ItemsControl x:Name="SkillList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="2" CornerRadius="6" Cursor="Hand"
                                        Background="{Binding Background}" BorderBrush="{Binding Border}" BorderThickness="1.5"
                                        Tag="{Binding}" MouseLeftButtonDown="Slot_Click">
                                    <Grid>
                                        <TextBlock Text="{Binding Number}" Foreground="#59FFFFFF" FontSize="9"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,2,0,0" />
                                        <TextBlock Text="{Binding KeyName}" Foreground="#FFFFFF" FontSize="13"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <!-- link + resize row -->
            <Grid Margin="2,12,0,0">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="LinkButton" Background="#26FFFFFF" CornerRadius="6" Cursor="Hand"
                            BorderBrush="#80FFFFFF" BorderThickness="1" Padding="14,7"
                            MouseLeftButtonDown="Link_Click">
                        <TextBlock Text="🔗 Холбох" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <Border x:Name="MarkerButton" Background="#26FFFFFF" CornerRadius="6" Cursor="Hand"
                            BorderBrush="#80FFFFFF" BorderThickness="1" Padding="14,7" Margin="8,0,0,0"
                            MouseLeftButtonDown="Markers_Click"
                            ToolTip="Товч дарахад ЧУХАМ ХААНА товшихыг дугаартай цагирагаар харуулна.&#10;Цагираг бүрийг чирж зөөгөөд Хадгалах дарвал тэр байрлал ашиглагдана.">
                        <TextBlock Text="📍 Шалгах · Засах" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Foreground="#80FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0"
                               MaxWidth="270" TextWrapping="Wrap"
                               Text="Картаа тоглоомын командын карт дээр яг давхарлаад Холбох дар" />
                </StackPanel>
                <Thumb x:Name="ResizeGrip" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Width="22" Height="22" Cursor="SizeNWSE">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="#01FFFFFF">
                                <TextBlock Text="◢" Foreground="#80FFFFFF" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>

            <TextBlock Foreground="#80FFFFFF" FontSize="10" Margin="2,8,0,0" TextWrapping="Wrap" MaxWidth="560"
                       Text="Тоглоом фокусаа алддаггүй. ◢ = хэмжээ өөрчлөх · Backspace = нүд цэвэрлэх · Esc = болих" />
        </StackPanel>
    </Border>
</Window>
